<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and transfer allowlists.

    Both transports intentionally expose the same narrow boundary as backup_rules.xml. Any future
    persistence location remains excluded until it is audited and deliberately added to all three
    allowlists with matching validation.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Local UI customization only: configured tab IDs and the last selected top-level tab ID. -->
        <include domain="file" path="datastore/arcane_tabs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- Do not transfer credentials or server-derived data directly between devices. -->
        <include domain="file" path="datastore/arcane_tabs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
