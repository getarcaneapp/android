<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower backup allowlist.

    Declaring an include disables the platform's default inclusion of app data. Keep this list
    semantically aligned with both sections in data_extraction_rules.xml. Server identity,
    credentials, environment/resource identifiers, cached responses, and operation state are
    intentionally excluded by omission.
-->
<full-backup-content>
    <!-- Local UI customization only: configured tab IDs and the last selected top-level tab ID. -->
    <include domain="file" path="datastore/arcane_tabs.preferences_pb" />
</full-backup-content>
